# Personal Health Engine production runtime environment
#
# TEMPLATE ONLY.
# Never put real API keys or tokens in this committed file.

# ------------------------------------------------------------
# L7
# ------------------------------------------------------------

L7_ENV=prod
L7_TIMEZONE=Asia/Shanghai

L7_REASONING_ADAPTER=deepseek
L7_MEDICAL_ADAPTER=medgemma

# These two secrets must be supplied only on the VPS.
L7_API_TOKEN=__SET_ON_SERVER__
DEEPSEEK_API_KEY=__SET_ON_SERVER__

# ------------------------------------------------------------
# DeepSeek
# ------------------------------------------------------------

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

# ------------------------------------------------------------
# MedGemma / Ollama
# ------------------------------------------------------------

MEDICAL_MODEL_MODE=local

# IMPORTANT:
# Ollama runs directly on the Linux host.
# L7 runs inside Docker and reaches the host through host.docker.internal.
MEDICAL_MODEL_ENDPOINT=http://host.docker.internal:11434

MEDGEMMA_MODEL=medgemma1.5

# ------------------------------------------------------------
# Runtime database paths inside the L7 container
# ------------------------------------------------------------

# L3-L5 are read-only upstream inputs.
L7_L3_DB=/data/l3/personal_health_features.sqlite3
L7_L4_DB=/data/l4/personal_health_baselines.sqlite3
L7_L5_DB=/data/l5/personal_health_analytics.sqlite3

# L6 MUST be read-write.
L7_L6_DB=/data/l6/personal_health_reasoning.sqlite3

# SEALED L6 code/definitions remain read-only.
L7_L6_CODE=/opt/l6/scripts
L7_L6_DEFINITIONS=/opt/l6/definitions

# L7 product database is read-write.
L7_DB=/data/l7/l7_product.sqlite3
