[Unit]
Description=Restrict Personal Health Engine Ollama to local and Docker networks
After=network-pre.target docker.service
Wants=docker.service
Before=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 11434 ! -i lo ! -s 172.16.0.0/12 -j DROP || /usr/sbin/iptables -I INPUT 1 -p tcp --dport 11434 ! -i lo ! -s 172.16.0.0/12 -j DROP'
ExecStop=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp --dport 11434 ! -i lo ! -s 172.16.0.0/12 -j DROP && /usr/sbin/iptables -D INPUT -p tcp --dport 11434 ! -i lo ! -s 172.16.0.0/12 -j DROP || true'

[Install]
WantedBy=multi-user.target
