[Unit]
Description=Personal Health Engine durable L7 worker
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/phe/deployment/docker
ExecStart=/usr/bin/docker compose -f docker-compose.production.yml up -d --no-deps l7-worker
ExecStop=/usr/bin/docker compose -f docker-compose.production.yml stop -t 30 l7-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
