[Unit]
Description=Personal Health Engine L1-L5 Collection Cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=phe
Group=phe

WorkingDirectory=/opt/phe

# Persistent data paths.
EnvironmentFile=/etc/phe/production-paths.conf

# L7 token + model runtime configuration.
EnvironmentFile=/etc/phe/runtime.env

Environment=PYTHONUNBUFFERED=1

# Repair only transport-level path/EOL drift whose bytes still match the sealed registry.
ExecStartPre=/opt/phe/.venv/bin/python /opt/phe/deployment/scripts/prepare_definition_files.py --code-root /opt/phe --data-root /srv/phe

# Stage 1:
# Xiaomi -> L1 -> L2 -> L3 -> L4 -> L5
ExecStart=/opt/phe/.venv/bin/python /opt/phe/deployment/scripts/run_daily_pipeline.py

# Stage 2:
# Runs only after ExecStart succeeds.
# The daily Python process has exited, therefore pipeline.lock
# has already been released before L7 tries to acquire its shared lock.
ExecStartPost=/opt/phe/.venv/bin/python /opt/phe/deployment/scripts/refresh_l7_after_pipeline.py

TimeoutStartSec=25min

StandardOutput=journal
StandardError=journal

SyslogIdentifier=phe-daily
